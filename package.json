{
  "name": "relic-clash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Relic Clash \u2014 warrior match-3 with tradable XRPL relics (prototype)",
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start:server": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "xrpl:setup": "tsx server/scripts/setupIssuer.ts",
    "xrpl:smoke": "tsx server/scripts/smoke.ts",
    "balance": "tsx scripts/balance.ts",
    "build:demo": "VITE_DEMO=1 vite build && node scripts/singlefile.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "https-proxy-agent": "^9.1.0",
    "phaser": "^3.90.0",
    "undici": "^8.12.4",
    "xrpl": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
