# Copy to .env (never commit .env). `npm run xrpl:setup` fills in the issuer for you.
PORT=8787
# XRPL Testnet only. Mainnet is out of scope for the prototype.
XRPL_NETWORK=wss://s.altnet.rippletest.net:51233
XRPL_EXPLORER=https://testnet.xrpl.org
XRPL_ISSUER_SEED=
# Base URL the NFT metadata URI points at (must be reachable by marketplaces to render nicely).
PUBLIC_BASE_URL=http://localhost:8787
# Royalty on secondary sales, units of 1/100,000 (5000 = 5%).
XRPL_TRANSFER_FEE=5000
# Platform flag (spec §12): set false for builds (e.g. iOS) where NFTs must be view-only.
ENABLE_NFT_DEPOSIT=true
# Max relics a player can use in one level.
MAX_RELICS_PER_LEVEL=3
